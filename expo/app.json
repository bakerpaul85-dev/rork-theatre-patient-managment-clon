{
  "expo": {
    "name": "Theatre Patient Management",
    "slug": "ecqra2znxssw7mr4bzfq8",
    "version": "1.2.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "rork-app",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.rork.ecqra2znxssw7mr4bzfq8",
      "infoPlist": {
        "NSCameraUsageDescription": "The camera is used to photograph hospital stickers, referral letters and other patient documents.",
        "NSLocationWhenInUseUsageDescription": "Location is added to form submissions and document photos as a POPIA audit trail.",
        "NSPhotoLibraryUsageDescription": "Photos can be attached to forms from your photo library."
      }
    },
    "android": {
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "app.rork.ecqra2znxssw7mr4bzfq8"
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://rork.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      "expo-mail-composer",
      "expo-image",
      "expo-sharing",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "imageWidth": 200
        }
      ],
      "expo-status-bar",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a", "armeabi-v7a"]
          }
        }
      ],
      "./plugins/withLowMemoryGradle"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
